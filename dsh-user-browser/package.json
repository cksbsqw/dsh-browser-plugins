{
  "name": "dsh-user-browser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "在用户的默认浏览器中新建标签页、打开网页和搜索 / Open tabs, pages, and searches in the user's default browser",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
